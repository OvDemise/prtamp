Meta.DisplayName=Project Reclaimer
Meta.Description=Project Reclaimer (Halo 3 / MCC) Dedicated Server
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=Delta
Meta.URL=https://projectreclaimer.dev/host
Meta.DisplayImageSource=url:https://projectreclaimer.dev/assets/img/logo-560.webp
Meta.EndpointURIFormat=
Meta.ConfigManifest=project-reclaimerconfig.json
Meta.MetaConfigManifest=project-reclaimermetaconfig.json
Meta.ConfigRoot=project-reclaimer.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The server is a Windows program that runs on Linux under Wine 9+ with Xvfb and the Visual C++ 2015-2022 runtime. Using a container avoids installing these on the host.
Meta.ExtraSetupStepsURI=https://projectreclaimer.dev/host
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=PreRelease
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.AppConfigId=f75e827b-8426-4b5c-beaa-b0c01c1300fd
App.DisplayName=Project Reclaimer
App.RootDir=./project-reclaimer/
App.BaseDirectory=./project-reclaimer/
App.ExecutableWin=project-reclaimer.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=
App.LinuxCommandLineArgs=-a wine "./project-reclaimer.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} dedicated
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","RECLAIMER_DEDICATED_HOST_NAME":"{{HostName}}","RECLAIMER_DEDICATED_ADMINS":"{{Admins}}","RECLAIMER_DEDICATED_STATS_SERVER":"{{StatsServer}}","RECLAIMER_DEDICATED_UPNP":"false","RECLAIMER_DEDICATED_AUTO_UPDATE":"false","RECLAIMER_DEDICATED_MASTER_ENABLED":"false","RECLAIMER_DEDICATED_RCON_PASSWORD":"{{$RemoteAdminPassword}}","RECLAIMER_DEDICATED_RCON_ADDRESS":"{{RconAddress}}","RECLAIMER_DEDICATED_MAX_PLAYERS":"{{$MaxUsers}}","RECLAIMER_DEDICATED_MIN_PLAYERS":"{{MinPlayers}}","RECLAIMER_DEDICATED_PASSWORD":"{{ServerPassword}}","RECLAIMER_DEDICATED_HIDDEN":"{{Hidden}}","RECLAIMER_DEDICATED_VOICE":"{{Voice}}","RECLAIMER_DEDICATED_VOICE_TEAM_ONLY":"{{VoiceTeamOnly}}","RECLAIMER_DEDICATED_TEXT_CHAT":"{{TextChat}}","RECLAIMER_DEDICATED_CHAT_LOG":"{{ChatLog}}","RECLAIMER_DEDICATED_VOTES":"{{Votes}}","RECLAIMER_DEDICATED_TEAM_CHANGING":"{{TeamChanging}}","RECLAIMER_DEDICATED_MAX_PING":"{{MaxPing}}","RECLAIMER_DEDICATED_LOAD_TIMEOUT":"{{LoadTimeout}}","RECLAIMER_DEDICATED_ANTI_CHEAT":"{{AntiCheat}}","RECLAIMER_DEDICATED_BLOCK_VPN":"{{BlockVPN}}","RECLAIMER_DEDICATED_SHARE_MODS":"{{ShareMods}}","RECLAIMER_DEDICATED_SHARE_RATE":"{{ShareRate}}"}
App.CommandLineParameterFormat={0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=CtrlC
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[project-reclaimerports.json]
App.AdminPortRef=RCONPort
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=
App.MaxUsers=16
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=SourceRCON
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=10
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[project-reclaimerupdates.json]
App.PreStartStages=[]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcessName=^{{$WineBaseDir}}project-reclaimer\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RCONConnected
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^([0-9a-f]{4}:(fixme|err|warn|trace):.*|.*Xvfb.*|.*XKEYBOARD.*|.*Could not find Wine (Gecko|Mono).*|ALSA lib .*|\[.+?\] Shell lifecycle event \d+: \{.*)$
Console.AppReadyRegex=
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=60
